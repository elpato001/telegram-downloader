<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_status_badge"
    android:backgroundTint="#FFFFFF">

    <!-- Indicador de barra superior / Header del Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Modo y Servidor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="#00C853"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAST MODE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp" />

    <!-- Tarjeta MODO RÁPIDO estilo FDM -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:strokeWidth="1dp"
        app:strokeColor="#A7F3D0"
        app:cardBackgroundColor="#F0FDF4"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODO MÁXIMA VELOCIDAD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#059669" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Velocidad de descarga"
                    android:textSize="12sp"
                    android:textColor="#475569" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ilimitada"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Velocidad actual en servidor"
                    android:textSize="12sp"
                    android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvDialogCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 MB/s"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Información de Conexión del Servidor -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CBD5E1"
        app:cardBackgroundColor="#F8FAFC"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALLES DE CONEXIÓN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estado"
                    android:textSize="12sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDialogServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectado"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Servidor NAS / PC"
                    android:textSize="12sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDialogServerHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="http://192.168.1.50:8000"
                    android:textSize="12sp"
                    android:textColor="#0369A1"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Descargas activas"
                    android:textSize="12sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvDialogActiveCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 activas"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogClearCompleted"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpiar terminadas"
            android:textColor="#64748B" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Configuración"
            app:backgroundTint="#0288D1" />
    </LinearLayout>

</LinearLayout>
