<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Lado Izquierdo: Insignia de tipo de archivo con botón de play/pausa superpuesto -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp">

            <!-- Caja con color según el tipo de archivo -->
            <LinearLayout
                android:id="@+id/layoutFileType"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_file_type"
                android:backgroundTint="#0288D1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileTypeExt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MP4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <ImageView
                    android:id="@+id/ivFileTypeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_video"
                    android:visibility="gone"
                    app:tint="#FFFFFF"
                    android:contentDescription="Tipo de archivo" />
            </LinearLayout>

            <!-- Círculo overlay inferior con estado/acción interactiva (Play / Pause / Check) -->
            <FrameLayout
                android:id="@+id/btnQuickToggle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_overlay">

                <ImageView
                    android:id="@+id/ivOverlayStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    app:tint="#0288D1"
                    android:contentDescription="Acción rápida" />
            </FrameLayout>

        </FrameLayout>

        <!-- Centro: Nombre, Detalles de descarga, barra de progreso y velocidad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre de archivo -->
            <TextView
                android:id="@+id/tvFilename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Romans.2017.WEB-DLRip-AVC.mp4"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:singleLine="true"
                android:lines="1"
                android:maxLines="1"
                android:ellipsize="middle"
                android:scrollHorizontally="true" />

            <!-- Línea de estado, velocidad y paquete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <!-- Flecha de descarga y velocidad -->
                <ImageView
                    android:id="@+id/ivSpeedArrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_arrow_downward"
                    app:tint="#0284C7"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.8 MB/s"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descargando"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tvPackageChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" • Paquete 1"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:scrollHorizontally="true" />
            </LinearLayout>

            <!-- Línea de tamaños, porcentaje y Barra de Progreso FDM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvProgressDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="190 MB / 1.35 GB"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12%"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:layout_marginStart="8dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:max="100"
                    android:progress="12"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp"
                    app:indicatorColor="#00BCD4"
                    app:trackColor="#E2E8F0" />
            </LinearLayout>

        </LinearLayout>

        <!-- Lado Derecho: Menú de opciones de 3 puntos (FDM) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMore"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            app:icon="@drawable/ic_more_vert"
            app:iconTint="#64748B"
            android:contentDescription="Opciones de descarga" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
