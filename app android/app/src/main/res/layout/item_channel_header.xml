<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fila 1: Flecha expandir, Icono carpeta, Badge Telegram, Nombre del Canal y Botones de acción -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">

            <!-- Botón expandir/contraer -->
            <ImageView
                android:id="@+id/ivExpandCollapse"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_primary"
                android:contentDescription="Expandir o contraer canal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Icono Carpeta -->
            <ImageView
                android:id="@+id/ivFolder"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder"
                app:tint="#F59E0B"
                android:layout_marginStart="4dp"
                android:contentDescription="Carpeta"
                app:layout_constraintStart_toEndOf="@id/ivExpandCollapse"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Pill Badge Canal de Telegram (se adapta al texto con constrainedWidth) -->
            <LinearLayout
                android:id="@+id/layoutChannelPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="#E0F2FE"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@id/ivFolder"
                app:layout_constraintEnd_toStartOf="@id/tvChannelCount"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_telegram"
                    android:contentDescription="Telegram" />

                <TextView
                    android:id="@+id/tvChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descargas Directas"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0369A1"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:scrollHorizontally="true"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <!-- Contador de archivos -->
            <TextView
                android:id="@+id/tvChannelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(37 archivos)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:lines="1"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintStart_toEndOf="@id/layoutChannelPill"
                app:layout_constraintEnd_toStartOf="@id/btnChannelToggle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Acciones de canal: Play/Pausa y Papelera -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChannelToggle"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/primary"
                android:contentDescription="Pausar o reanudar todo el canal"
                app:layout_constraintEnd_toStartOf="@id/btnChannelDelete"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChannelDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/status_error"
                android:contentDescription="Eliminar todo el canal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Barra de Progreso del Canal -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBarChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="35"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_variant" />

        <!-- Fila 2: Detalles de progreso y Velocidad global del canal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tvChannelProgressDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="168 MB / 37.64 GB (0.4%)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:lines="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:scrollHorizontally="true" />

            <TextView
                android:id="@+id/tvChannelSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.2 MB/s"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:singleLine="true"
                android:lines="1"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
